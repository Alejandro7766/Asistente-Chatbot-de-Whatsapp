    {
      "parameters": {
        "jsCode": "// El evento se creó con summary 'Cita: {nombre} - {tratamiento}'\n// y description 'Tel: {telefono} | Reservado vía WhatsApp bot'\nconst item = $json;\nconst summary = item.summary || '';\nconst description = item.description || '';\nconst partesSummary = summary.replace(/^Cita:\\s*/, '').split(' - ');\nconst nombre = partesSummary[0] ? partesSummary[0].trim() : 'paciente';\nconst tratamiento = partesSummary[1] ? partesSummary[1].trim() : '';\nconst telMatch = description.match(/Tel:\\s*([^|]+)/);\nlet telefono = telMatch ? telMatch[1].trim() : null;\n// Normaliza a formato E.164 con prefijo España\nif (telefono) {\n  telefono = telefono.replace(/[\\s\\-()]/g, ''); // quita espacios, guiones, paréntesis\n  if (telefono.startsWith('+')) {\n    telefono = telefono.substring(1);\n  } else if (telefono.startsWith('34') && telefono.length === 11) {\n    // ya tiene el 34 delante, no tocar\n  } else if (!telefono.startsWith('34')) {\n    telefono = '34' + telefono;\n  }\n}\nconst attendee = (item.attendees || [])[0];\nconst start = item.start && (item.start.dateTime || item.start.date);\nreturn [{ json: {\n  event_id: item.id,\n  nombre: nombre,\n  telefono: telefono,\n  tratamiento: tratamiento,\n  email: attendee ? attendee.email : null,\n  fecha_hora: start\n} }];"
      },
